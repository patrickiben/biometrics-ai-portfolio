# Copy outside the repository, restrict permissions, and supply real values.
# Used by service manager EnvironmentFile; the Python programs read environment vars.
TRACKER_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Leave unset for team access behind HTTPS. Set 1 ONLY for local HTTP preview.
# TRACKER_INSECURE_LOCAL=1
# Team hosting: comma-separated public hostnames, without scheme/path.
# TRACKER_ALLOWED_HOSTS=tracker.example.org

# Email stays disabled while this is empty. Configure intended recipients to enable.
TRACKER_ALERT_TO=
TRACKER_SMTP_HOST=
TRACKER_SMTP_PORT=587
TRACKER_SMTP_SECURITY=starttls
TRACKER_SMTP_FROM=
TRACKER_SMTP_USERNAME=
TRACKER_SMTP_PASSWORD=
TRACKER_PUBLIC_URL=
