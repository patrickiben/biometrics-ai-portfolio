[Unit]
Description=Open Study Tracker shared web service
After=network.target

[Service]
Type=simple
User=tracker
Group=tracker
WorkingDirectory=/opt/biometrics-ai-portfolio
EnvironmentFile=/etc/open-study-tracker.env
ExecStart=/opt/biometrics-ai-portfolio/open_tracker/.venv/bin/python open_tracker/server.py --db /var/lib/open-study-tracker/shared.sqlite serve --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/open-study-tracker

[Install]
WantedBy=multi-user.target
